<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Join - QR Attendance</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/face-api.js@0.22.2/dist/face-api.min.js"></script>
    <style>
        /* Use consistent styles */
        body { 
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e); 
            color: white; margin: 0; min-height: 100vh; 
            font-family: 'Poppins', sans-serif;
        }

        /* Top Bar */
        .top-bar {
            width: 100%; padding: 15px 40px;
            display: flex; justify-content: space-between; align-items: center;
            background: rgba(15, 12, 41, 0.95); backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            position: sticky; top: 0; z-index: 1000;
        }
        .logo-area { display: flex; align-items: center; gap: 10px; }
        .logo-icon { 
            width: 32px; height: 32px; background: #00d2d3; 
            border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #000;
        }
        .logo-text { font-weight: 700; font-size: 1.2rem; }
        .system-status { 
            display: flex; align-items: center; gap: 10px; 
            font-size: 0.8rem; color: rgba(255,255,255,0.7); 
            background: rgba(255,255,255,0.05); padding: 5px 15px; border-radius: 20px;
        }
        .status-dot { width: 6px; height: 6px; background: #00b894; border-radius: 50%; box-shadow: 0 0 8px #00b894; animation: pulse 2s infinite; }
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }
        .icon-btn {
            background: rgba(255,255,255,0.1); border: none; color: white;
            width: 35px; height: 35px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: 0.2s; text-decoration: none;
        }

        /* Layout */
        .register-container {
            display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
            padding: 40px 20px; gap: 40px; position: relative; z-index: 5;
        }
        
        /* Left: Photo Upload */
        .upload-section {
            flex: 1; min-width: 300px; max-width: 350px;
            display: flex; flex-direction: column; align-items: center;
            transition: opacity 0.3s;
        }
        .photo-card {
            width: 100%; aspect-ratio: 3/4;
            background: rgba(255,255,255,0.05);
            border: 2px dashed rgba(255,255,255,0.2);
            border-radius: 24px;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            position: relative; overflow: hidden;
            transition: 0.3s; cursor: pointer;
        }
        .photo-card:hover { border-color: #a29bfe; background: rgba(162, 155, 254, 0.05); }
        .photo-card.has-image { border-style: solid; border-color: #00b894; }
        #imagePreview { width: 100%; height: 100%; object-fit: cover; display: none; }
        .upload-icon { font-size: 3rem; margin-bottom: 10px; }
        .status-badge {
            margin-top: 15px; padding: 8px 15px; border-radius: 20px;
            font-size: 0.8rem; background: rgba(0,0,0,0.3); color: #fab1a0;
            display: inline-flex; align-items: center; gap: 8px;
        }

        /* Right: Form */
        .form-section {
            flex: 1; min-width: 300px; max-width: 450px;
            background: rgba(255,255,255,0.05); backdrop-filter: blur(20px);
            padding: 40px; border-radius: 30px;
            border: 1px solid rgba(255,255,255,0.1);
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        }
        
        /* Inputs */
        .input-group { margin-bottom: 15px; }
        input:not([type="radio"]) {
            width: 100%; padding: 12px 15px;
            background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px; color: white; outline: none; font-family: 'Poppins', sans-serif; font-size: 0.95rem;
        }
        input:focus { border-color: #00d2d3; background: rgba(0,0,0,0.4); }

        /* Phone Input Styling */
        .phone-wrapper {
            display: flex; align-items: stretch;
        }
        .country-code {
            background: rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.7);
            display: flex; align-items: center; justify-content: center;
            padding: 0 15px;
            border-radius: 10px 0 0 10px;
            border: 1px solid rgba(255,255,255,0.1);
            border-right: none;
            font-weight: 500;
            font-size: 0.95rem;
        }
        .phone-input {
            border-radius: 0 10px 10px 0 !important;
            flex: 1;
        }
        
        /* Role Toggle */
        .role-toggle-container {
            background: rgba(0,0,0,0.2); padding: 4px; border-radius: 12px;
            display: flex; margin-bottom: 25px;
        }
        .role-toggle-container input { display: none; }
        .toggle-btn {
            flex: 1; padding: 10px; text-align: center; cursor: pointer;
            border-radius: 8px; font-size: 0.9rem; color: rgba(255,255,255,0.6); transition: 0.3s;
        }
        input:checked + label { background: #6c5ce7; color: white; font-weight: 600; }

        .btn-primary {
            width: 100%; padding: 14px; border: none; border-radius: 10px;
            background: linear-gradient(135deg, #00d2d3, #0abde3); color: white;
            font-weight: 600; cursor: pointer; transition: 0.3s; font-size: 1rem;
        }
        .btn-primary:disabled { background: #2d3436; cursor: not-allowed; opacity: 0.7; }
    </style>
</head>
<body>

<div class="background-anim" style="position:fixed; top:0; left:0; width:100%; height:100%; z-index:-1; pointer-events:none;">
    <span style="position:absolute; width:100px; height:100px; background:rgba(108,92,231,0.1); border-radius:50%; top:20%; left:10%;"></span>
    <span style="position:absolute; width:150px; height:150px; background:rgba(0,210,211,0.05); border-radius:50%; bottom:10%; right:5%;"></span>
</div>

<!-- TOP BAR -->
<div class="top-bar">
    <div class="logo-area">
        <div class="logo-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg></div>
        <span class="logo-text">QR Attendance</span>
    </div>
    <div style="display: flex; gap: 10px; align-items: center;">
        <div class="system-status"><div class="status-dot"></div><span>System Operational</span><span style="margin:0 5px; opacity:0.3;">|</span><span id="liveClock">--:--</span></div>
        <a href="/login" class="icon-btn" title="Back to Login">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        </a>
    </div>
</div>

<div class="register-container">
    
    <!-- LEFT: Photo Upload -->
    <div class="upload-section" id="photoSection">
        <h2 style="margin-bottom: 15px; font-weight:600;">Profile Photo</h2>
        
        <input type="file" id="fileInput" accept="image/*" style="display: none;">
        <label for="fileInput" class="photo-card" id="dropZone">
            <img id="imagePreview">
            <div id="uploadPlaceholder" style="text-align:center;">
                <div class="upload-icon">📸</div>
                <p style="font-size:0.9rem; opacity:0.6;">Tap to Upload</p>
                <p style="font-size:0.7rem; opacity:0.3;">Selfie / Portrait</p>
            </div>
        </label>

        <div id="faceStatus" class="status-badge">
            <div class="status-dot" style="background:#fab1a0;"></div>
            Waiting for photo...
        </div>
    </div>

    <!-- RIGHT: Form Data -->
    <div class="form-section">
        <h1 style="font-size: 2rem; margin-bottom: 5px;">Create Account</h1>
        <p style="opacity:0.5; margin-bottom: 30px;">Join the future of attendance.</p>

        <!-- Error Display -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div style="background: rgba(255,71,87,0.2); color: #ff6b81; padding: 10px; border-radius: 8px; margin-bottom: 20px;"><%= error %></div>
        <% } %>

        <form action="/register" method="POST" id="regForm" onsubmit="return preparePhone()">
            
            <div class="role-toggle-container">
                <input type="radio" id="role-student" name="role" value="user" checked onchange="toggleSecretField()">
                <label for="role-student" class="toggle-btn">Student</label>
                <input type="radio" id="role-teacher" name="role" value="client" onchange="toggleSecretField()">
                <label for="role-teacher" class="toggle-btn">Teacher</label>
            </div>

            <div class="input-group">
                <input type="text" name="username" placeholder="Full Name / ID" required>
            </div>
            
            <!-- PHONE INPUT -->
            <div class="input-group phone-wrapper">
                <div class="country-code">+91</div>
                <input type="tel" id="phoneDisplay" class="phone-input" placeholder="9876543210" maxlength="10" pattern="[0-9]{10}" title="Please enter a valid 10-digit mobile number" required oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                <!-- Hidden Input sent to server -->
                <input type="hidden" name="phone" id="phoneHidden">
            </div>

            <div class="input-group">
                <input type="password" name="password" placeholder="Set Password" required>
            </div>

            <!-- SECRET KEY FIELD (Hidden by default) -->
            <div class="input-group" id="secretField" style="display: none;">
                <input type="password" name="adminSecret" placeholder="Teacher Access Key (Required)" style="border-color: #ff7675;">
            </div>

            <input type="hidden" name="faceDescriptor" id="faceDescriptor">
            <input type="hidden" name="profilePhoto" id="profilePhoto">
            
            <button type="submit" class="btn btn-primary" id="submitBtn" disabled style="margin-top: 10px;">
                Complete Registration
            </button>
        </form>

        <div style="margin-top: 20px; text-align: center; font-size: 0.9rem;">
            <a href="/login" style="color: #a29bfe; text-decoration: none;">Already have an account? Login</a>
        </div>
    </div>
</div>

<script>
    function updateClock() { document.getElementById('liveClock').innerText = new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }); }
    setInterval(updateClock, 1000); updateClock();

    const fileInput = document.getElementById('fileInput');
    const imagePreview = document.getElementById('imagePreview');
    const placeholder = document.getElementById('uploadPlaceholder');
    const dropZone = document.getElementById('dropZone');
    const faceStatus = document.getElementById('faceStatus');
    const submitBtn = document.getElementById('submitBtn');
    const faceInput = document.getElementById('faceDescriptor');
    const photoInput = document.getElementById('profilePhoto');
    const secretField = document.getElementById('secretField');
    const photoSection = document.getElementById('photoSection');

    // 1. Prepare Phone
    function preparePhone() {
        const userPhone = document.getElementById('phoneDisplay').value;
        if(userPhone.length !== 10) {
            alert("Please enter a valid 10-digit mobile number.");
            return false;
        }
        document.getElementById('phoneHidden').value = "+91" + userPhone;
        return true;
    }

    // 2. Load AI
    if (typeof faceapi !== 'undefined') {
        Promise.all([
            faceapi.nets.tinyFaceDetector.loadFromUri('/models'),
            faceapi.nets.faceLandmark68Net.loadFromUri('/models'),
            faceapi.nets.faceRecognitionNet.loadFromUri('/models')
        ]).then(() => {
            faceStatus.innerHTML = '<span style="color:#a29bfe">●</span> AI Ready. Select Photo.';
        });
    }

    // 3. Toggle Logic (Show Secret Key for Teacher)
    function toggleSecretField() {
        const isTeacher = document.getElementById('role-teacher').checked;

        if (isTeacher) {
            secretField.style.display = 'block';
            document.querySelector('input[name="adminSecret"]').required = true;
            
            // Disable Photo Upload visually for Teachers
            photoSection.style.opacity = '0.3';
            photoSection.style.pointerEvents = 'none';
            
            // Teachers don't need face ID to submit
            submitBtn.disabled = false;
        } else {
            secretField.style.display = 'none';
            document.querySelector('input[name="adminSecret"]').required = false;

            // Enable Photo Upload for Students
            photoSection.style.opacity = '1';
            photoSection.style.pointerEvents = 'all';

            // Disable submit until face is found
            if(!faceInput.value) submitBtn.disabled = true;
        }
    }

    // 4. Handle File Upload
    fileInput.addEventListener('change', async () => {
        const file = fileInput.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (e) => {
            imagePreview.src = e.target.result;
            imagePreview.style.display = 'block';
            placeholder.style.display = 'none';
            dropZone.classList.add('has-image');
            photoInput.value = e.target.result;
            processFace(e.target.result);
        };
        reader.readAsDataURL(file);
    });

    // 5. Process Face
    async function processFace(imageSrc) {
        const isStudent = document.getElementById('role-student').checked;
        if(!isStudent) return;

        faceStatus.innerHTML = '⏳ Analyzing...';
        submitBtn.disabled = true;
        
        try {
            const img = await faceapi.fetchImage(imageSrc);
            const detection = await faceapi.detectSingleFace(img, new faceapi.TinyFaceDetectorOptions()).withFaceLandmarks().withFaceDescriptor();
            
            if (detection) {
                faceInput.value = JSON.stringify(Array.from(detection.descriptor));
                
                faceStatus.innerHTML = '<span style="color:#00b894">✔</span> Face Detected';
                faceStatus.style.color = "#00b894";
                faceStatus.style.background = "rgba(0, 184, 148, 0.1)";
                submitBtn.disabled = false;
            } else {
                faceStatus.innerHTML = '<span style="color:#ff7675">✖</span> No Face Found';
                faceStatus.style.color = "#ff7675";
                submitBtn.disabled = true;
            }
        } catch (e) { console.error(e); }
    }
</script>
</body>
</html>