<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Teacher Dashboard</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="shortcut icon" href="/favicon.svg">
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { background: linear-gradient(135deg, #0f0c29, #302b63, #24243e); color: white; margin: 0; min-height: 100vh; }
        .swal2-container { z-index: 3000 !important; }

        .top-bar { width: 100%; padding: 15px 40px; display: flex; justify-content: space-between; align-items: center; background: rgba(15, 12, 41, 0.95); border-bottom: 1px solid rgba(255,255,255,0.05); position: sticky; top: 0; z-index: 1000; }
        .logo-area { display: flex; align-items: center; gap: 10px; }
        .logo-icon { width: 32px; height: 32px; background: #00d2d3; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #000; font-weight: bold; }
        
        .sub-nav { background: rgba(255, 255, 255, 0.05); padding: 10px 40px; display: flex; gap: 20px; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
        .sub-nav a { color: #a29bfe; text-decoration: none; font-size: 0.9rem; font-weight: 500; padding: 5px 10px; border-radius: 6px; transition: 0.3s; }
        .sub-nav a:hover { background: rgba(255,255,255,0.1); color: white; }
        .sub-nav .active-link { background: rgba(108, 92, 231, 0.3); color: #fff; }
        .welcome-msg { margin-left: auto; font-size: 0.9rem; color: #fab1a0; font-weight: 600; }

        .container { max-width: 1200px; margin: 40px auto; padding: 0 20px; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px; }
        .stat-card { background: rgba(255,255,255,0.05); padding: 20px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(10px); }
        .stat-num { font-size: 2rem; font-weight: 700; margin-bottom: 5px; color: #00d2d3; }
        .stat-label { font-size: 0.9rem; color: #b2bec3; }

        .action-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .btn-primary { background: linear-gradient(135deg, #6c5ce7, #a29bfe); border: none; padding: 12px 24px; border-radius: 12px; color: white; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 8px; transition: transform 0.2s; text-decoration: none;}
        .btn-primary:hover { transform: translateY(-2px); }
        .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }
        .btn-warning { background: linear-gradient(135deg, #e67e22, #f39c12); border: none; padding: 12px 24px; border-radius: 12px; color: white; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 8px; transition: transform 0.2s; text-decoration: none;}

        .session-list { display: grid; gap: 15px; }
        .session-card { background: rgba(255,255,255,0.03); padding: 20px; border-radius: 16px; display: flex; justify-content: space-between; align-items: center; border: 1px solid rgba(255,255,255,0.05); transition: 0.3s; }
        .session-card:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2); }
        .status-dot { height: 10px; width: 10px; border-radius: 50%; display: inline-block; margin-right: 8px; }
        .active { background: #00b894; box-shadow: 0 0 10px #00b894; }
        .inactive { background: #636e72; }

        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); justify-content: center; align-items: center; z-index: 2000; backdrop-filter: blur(5px); }
        .modal-content { background: #1e1e2e; padding: 30px; border-radius: 20px; width: 400px; border: 1px solid rgba(255,255,255,0.1); position: relative; }
        .input-group { margin-bottom: 20px; position: relative; }
        .input-group label { display: block; margin-bottom: 8px; font-size: 0.9rem; color: #a29bfe; }
        .input-group input, .input-group select { width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: white; outline: none; box-sizing: border-box; }
        .modal-actions { display: flex; gap: 10px; justify-content: flex-end; }
        .btn-cancel { background: transparent; border: 1px solid rgba(255,255,255,0.2); color: white; padding: 10px 20px; border-radius: 8px; cursor: pointer; }

        .suggestions-dropdown { position: absolute; top: 100%; left: 0; width: 100%; background: #2d3436; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; max-height: 150px; overflow-y: auto; z-index: 2500; display: none; margin-top: 5px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
        .suggestion-item { padding: 10px 15px; cursor: pointer; border-bottom: 1px solid rgba(255,255,255,0.05); transition: 0.2s; font-size: 0.9rem; }
        .suggestion-item:hover { background: #6c5ce7; color: white; }
        .suggestion-item:last-child { border-bottom: none; }
    </style>
</head>
<body>

<div class="top-bar">
    <div class="logo-area">
        <img src="/favicon.svg" alt="Smart QR Shield" style="width: 32px; height: 32px; object-fit: contain; filter: drop-shadow(0 0 6px rgba(0,210,211,0.5));">
        <span style="font-weight: 600; letter-spacing: 0.5px;">Teacher Dashboard</span>
    </div>
    <div style="display:flex; align-items:center; gap:20px;">
        <span id="liveClock" style="font-family: monospace; color: #00d2d3;"></span>
        <a href="/logout" style="color: #ff7675; text-decoration:none; font-size:0.9rem;">Logout</a>
    </div>
</div>

<div class="sub-nav">
    <a href="/client/dashboard" class="active-link">Dashboard</a>
    <a href="/client/verify-students">Verify Students (<%= pendingCount %>)</a>
    <a href="/client/manage-students">Student Database</a>
    <a href="/profile">Profile</a>
    <span class="welcome-msg">Welcome, <%= username %>!</span>
</div>

<div class="container">
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-num"><%= sessions.filter(s => s.isActive).length %></div>
            <div class="stat-label">Active Sessions</div>
        </div>
        <div class="stat-card">
            <div class="stat-num"><%= sessions.length %></div>
            <div class="stat-label">Total Sessions Created</div>
        </div>
    </div>

    <div class="action-bar">
        <h2 style="margin: 0;">Your Sessions</h2>
        <div style="display:flex; gap:10px;">
            <button class="btn-warning" onclick="openManualModal()">+ Manual Entry</button>
            <button class="btn-primary" onclick="openCreateModal()">+ Create Session</button>
        </div>
    </div>

    <div class="session-list">
        <% sessions.forEach(session => { %>
            <div class="session-card">
                <div>
                    <h3 style="margin: 0 0 5px 0;"><%= session.title %></h3>
                    <div style="font-size: 0.85rem; color: #aaa;">
                        <span class="status-dot <%= session.isActive ? 'active' : 'inactive' %>"></span>
                        <%= session.isActive ? 'Live Now' : 'Closed' %> • <%= new Date(session.createdAt).toLocaleDateString() %>
                    </div>
                </div>
                <div style="display: flex; gap: 10px;">
                    <a href="/client/session/<%= session._id %>" class="btn-primary" style="background: rgba(255,255,255,0.1); padding: 8px 16px;">View</a>
                    <button onclick="openDeleteModal('<%= session._id %>', '<%= session.title %>')" class="btn-cancel" style="border-color: #ff7675; color: #ff7675;">Delete</button>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<div id="createModal" class="modal">
    <div class="modal-content">
        <h2 style="margin-top: 0;">New Session</h2>
        <form action="/client/create-session" method="POST" id="createSessionForm">
            <div class="input-group">
                <label>Session Title (e.g., "Math 101")</label>
                <input type="text" name="title" required autofocus>
            </div>
            
            <input type="hidden" name="lat" id="sessionLat">
            <input type="hidden" name="lng" id="sessionLng">
            
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeCreateModal()">Cancel</button>
                <button type="submit" class="btn-primary" id="createBtn">Create & Go Live</button>
            </div>
        </form>
    </div>
</div>

<div id="manualModal" class="modal">
    <div class="modal-content">
        <h2 style="margin-top: 0;">Manual Attendance</h2>
        <p style="font-size:0.9rem; color:#aaa; margin-bottom:20px;">Type to search registered students.</p>
        
        <form id="manualAttendanceForm" onsubmit="handleManualSubmit(event)">
            <div class="input-group">
                <label>Select Session</label>
                <select id="manualSessionId" name="sessionId" required>
                    <% sessions.forEach(session => { %>
                        <option value="<%= session._id %>"><%= session.title %> (<%= new Date(session.createdAt).toLocaleDateString() %>)</option>
                    <% }) %>
                </select>
            </div>
            
            <div class="input-group">
                <label>Student Name / Username</label>
                <input type="text" id="manualUsername" name="username" placeholder="Start typing name..." autocomplete="off" oninput="filterStudents()" required>
                <div id="studentSuggestions" class="suggestions-dropdown"></div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeManualModal()">Cancel</button>
                <button type="submit" class="btn-warning">Mark Present</button>
            </div>
        </form>
    </div>
</div>

<div id="deleteModal" class="modal">
    <div class="modal-content" style="max-width: 350px; text-align: center;">
        <h3 style="margin-top: 0;">Confirm Deletion</h3>
        <p style="color: #aaa; margin-bottom: 20px;">Delete <b id="modalSessionName"></b>? This action cannot be undone.</p>
        <div class="modal-actions" style="justify-content: center;">
            <button type="button" class="btn-cancel" onclick="closeDeleteModal()">Cancel</button>
            <button type="button" id="confirmDeleteBtn" class="btn-primary" style="background: #ff7675;">Delete</button>
        </div>
    </div>
</div>
<form id="deleteForm" method="POST" style="display:none;"></form>

<script>
    function updateClock() { document.getElementById('liveClock').innerText = new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }); }
    setInterval(updateClock, 1000); updateClock();
    
    function openCreateModal() { 
        document.getElementById('createModal').style.display = 'flex'; 
        const createBtn = document.getElementById('createBtn');
        createBtn.innerText = "Getting GPS...";
        createBtn.disabled = true;

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    document.getElementById('sessionLat').value = pos.coords.latitude;
                    document.getElementById('sessionLng').value = pos.coords.longitude;
                    createBtn.innerText = "Create & Go Live";
                    createBtn.disabled = false;
                },
                (err) => { 
                    alert("Location access is heavily required to secure the classroom geofence. Please allow location permissions."); 
                    closeCreateModal(); 
                },
                { enableHighAccuracy: true }
            );
        } else {
            alert("Geolocation is not supported by your browser.");
            closeCreateModal();
        }
    }
    function closeCreateModal() { document.getElementById('createModal').style.display = 'none'; }
    
    let sessionToDeleteId = null;
    function openDeleteModal(id, title) {
        sessionToDeleteId = id;
        document.getElementById('modalSessionName').innerText = `"${title}"`;
        document.getElementById('deleteModal').style.display = 'flex';
    }
    function closeDeleteModal() { document.getElementById('deleteModal').style.display = 'none'; }
    
    document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
        if (sessionToDeleteId) {
            const form = document.getElementById('deleteForm');
            form.action = `/client/session/${sessionToDeleteId}/delete`;
            form.submit();
        }
    });

    let allStudents = [];

    function openManualModal() { 
        document.getElementById('manualModal').style.display = 'flex';
        fetchStudents(); 
    }
    function closeManualModal() { 
        document.getElementById('manualModal').style.display = 'none';
        document.getElementById('studentSuggestions').style.display = 'none'; 
    }

    function fetchStudents() {
        fetch('/client/get-all-students')
            .then(res => res.json())
            .then(data => { allStudents = data; })
            .catch(err => console.error("Error fetching students:", err));
    }

    function filterStudents() {
        const input = document.getElementById('manualUsername');
        const filter = input.value.toLowerCase();
        const suggestionsDiv = document.getElementById('studentSuggestions');
        
        suggestionsDiv.innerHTML = '';

        if (!filter) {
            suggestionsDiv.style.display = 'none';
            return;
        }

        const matches = allStudents.filter(s => s.username.toLowerCase().includes(filter));
        if (matches.length > 0) {
            matches.forEach(student => {
                const div = document.createElement('div');
                div.className = 'suggestion-item';
                div.innerText = student.username;
                div.onclick = () => selectStudent(student.username);
                suggestionsDiv.appendChild(div);
            });
            suggestionsDiv.style.display = 'block';
        } else {
            suggestionsDiv.style.display = 'none';
        }
    }

    function selectStudent(name) {
        document.getElementById('manualUsername').value = name;
        document.getElementById('studentSuggestions').style.display = 'none';
    }

    function handleManualSubmit(e) {
        e.preventDefault();
        const sessionId = document.getElementById('manualSessionId').value;
        const username = document.getElementById('manualUsername').value;

        fetch('/client/manual-attendance', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sessionId, username })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                closeManualModal(); 
                Swal.fire({
                    icon: 'success',
                    title: 'Marked!',
                    text: `Successfully marked ${username} present.`,
                    background: '#1e1e2e', color: '#fff', confirmButtonColor: '#00b894'
                }).then(() => {
                    window.location.href = `/client/session/${sessionId}`;
                });
            } else {
                if (data.message.includes('not found')) {
                    Swal.fire({ icon: 'error', title: 'Student Not Found', text: `Username "${username}" does not exist.`, background: '#1e1e2e', color: '#fff', confirmButtonColor: '#ff7675' });
                } else if (data.message.includes('Already')) {
                    closeManualModal();
                    Swal.fire({ icon: 'warning', title: 'Already Marked', text: `${username} is already present.`, background: '#1e1e2e', color: '#fff', confirmButtonColor: '#fdcb6e' });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, background: '#1e1e2e', color: '#fff' });
                }
            }
        })
        .catch(err => {
            console.error(err);
            Swal.fire({ icon: 'error', title: 'Server Error', background: '#1e1e2e', color: '#fff' });
        });
    }

    window.onclick = function(e) { 
        if(e.target == document.getElementById('createModal')) closeCreateModal();
        if(e.target == document.getElementById('deleteModal')) closeDeleteModal();
        if(e.target == document.getElementById('manualModal')) closeManualModal();
        
        if(e.target != document.getElementById('manualUsername')) {
            document.getElementById('studentSuggestions').style.display = 'none';
        }
    }
</script>

</body>
</html>