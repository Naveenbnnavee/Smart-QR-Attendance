# ==============================================================================
# Smart QR Attendance - Production Environment Configuration
# ==============================================================================
# Copy this file to .env for local development.
# In production (e.g., Render, Railway), set these in the service Dashboard:
#   Settings > Environment Variables
#
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Server Listening Port (Render assigns PORT automatically, defaults to 3000 locally)
PORT=3000

# MongoDB Connection String (e.g., MongoDB Atlas free M0 cluster)
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/attendance?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/attendance

# Secret Passcode for Faculty/Admin Authentication
ADMIN_SECRET=your_secure_admin_passcode_here

# Express Session Encryption Secret (32+ character random string)
SESSION_SECRET=your_32_char_secure_session_secret_key

# Optional: Twilio SMS / WhatsApp Alerts for Truancy / Proxy Detection
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
